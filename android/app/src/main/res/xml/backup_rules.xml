<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 ve altinda kullanilan eski Auto Backup kural dosyasi.
     Sadece acikca dahil edilenler yedeklenir; listelenmemis her sey
     (orn. flutter_secure_storage'in cihaza ozel sifreli verileri)
     otomatik olarak yedek DISIDIR — ayrica <exclude> yazmaya gerek yok.
     (Onceki surumde yazilan <exclude>, dahil edilmemis bir yolu hedefledigi
     icin Android lint hatasi veriyordu; kaldirildi.) -->
<full-backup-content>
    <include domain="database" path="skt_takip.db" />
    <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
</full-backup-content>
