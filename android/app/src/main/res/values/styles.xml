<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- EDGE-TO-EDGE: Status bar GIZLENMIYOR; seffaf yapiliyor ve uygulama
         icerigi (AppBar/banner gradient) onun arkasina uzaniyor. Boylece
         status bar, ust bardaki renk neyse onu gosterir; siyah serit OLMAZ.
         windowFullscreen=true ESKI yontemiydi ve Xiaomi/MIUI'de siyah serit
         birakiyordu — kaldirildi. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
